[Unit]
Description=Rüsthaus-App: neue Version von GitHub installieren
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ruesthaus
Group=ruesthaus
ExecStart=/usr/local/bin/ruesthaus-update
StateDirectory=ruesthaus
# Härtung: darf nur in den App-Ordner und seinen Status-Ordner schreiben
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/www/ruesthaus
